<% content_for :page_title, "申請の新規作成" %>
<div class="d-flex flex-column align-items-center px-4 px-lg-5">
  <%# ステッパー %>
  <%= render "stepper", current_step: 1 %>

  <%# フォームカード %>
  <section class="central-card p-4 p-md-5 p-sm-4">
    <div class="mb-4">
      <h3 class="h5 fw-bold text-primary mb-1" style="color: var(--primary-color) !important">
        基本情報の入力
      </h3>
      <p class="text-muted small">
        申請のタイトルと補足事項を入力してください。
      </p>
    </div>
    <%# 入力フォーム %>
    <%= render "form_card", expense_report: @expense_report %>
  </section>
</div>
