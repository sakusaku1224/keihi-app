<% content_for :page_title, @expense_report.draft? ? "明細追加" : "申請詳細" %>
<div class="container-field row justify-content-center px-4 px-lg-5">
  <div class="col-12 col-md-10">
    <%# ステッパー・承認タイムライン %>
    <div class="d-flex justify-content-center">
      <% if @expense_report.draft? %>
        <%= render "stepper", current_step: 2 %>
      <% elsif @expense_report.submitted? || @expense_report.approved? %>
        <%= render "approval_timeline", expense_report: @expense_report %>
      <% end %>
    </div>

    <%# ヘッダーカード %>
    <%= render "report_header", expense_report: @expense_report %>

    <%# 明細一覧 %>
    <%= render "items_table", expense_report: @expense_report, expense_items: @expense_report.expense_items %>

    <%# ボタン %>
    <div class="pt-4 border-top d-flex flex-column align-items-center gap-3">
      <% if @expense_report.draft? %>
        <%# 下書き状態のみ編集可能 %>
        <%= link_to self_check_expense_report_path(@expense_report),
            class: "btn btn-primary-keihi rounded-pill px-5 fw-bold #{'disabled' if @expense_report.expense_items.empty?}",
            style: "min-width: 320px;" do %>
          確認・提出へ進む <i class="bi bi-arrow-right"></i>
        <% end %>
        <%= link_to "← 基本情報を編集する", edit_expense_report_path(@expense_report),
            class: "btn btn-link fw-bold small text-decoration-none",
            style: "color: var(--primary-color);" %>
        <div class="w-100 d-flex justify-content-end gap-2 mt-2">
          <%= link_to expense_reports_path,
              class: "btn btn-outline-secondary border-0 d-flex align-items-center gap-1 fw-bold" do %>
            <i class="bi bi-floppy"></i> 下書き保存
          <% end %>
          <button type="button" class="btn btn-outline-danger border-0 d-flex align-items-center gap-1 fw-bold"
                  data-bs-toggle="modal" data-bs-target="#deleteReportModal">
            <i class="bi bi-trash3"></i> 申請を削除
          </button>
        </div>
      <% else %>
        <%= link_to expense_reports_path, class: "btn btn-primary-keihi rounded-pill px-5 fw-bold", style: "min-width: 320px;" do%>
          <i class="bi bi-arrow-left"></i>申請一覧に戻る
        <% end %>
      <% end %>
    </div>
  </div>

  <%# 削除モーダル %>
  <div class="modal fade" id="deleteReportModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title">申請を削除しますか？</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p">この申請を削除します。この操作は取り消せません。</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">キャンセル</button>
          <%= link_to "削除する", expense_report_path(@expense_report),
              data: { turbo_method: :delete },
              class: "btn btn-danger px-4 fw-bold rounded-2" %>
        </div>
      </div>
    </div>
  </div>

  <%# 明細追加モーダル %>
  <div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="addItemModalLabel">明細を追加</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= render "expense_items/form", expense_report: @expense_report, expense_item: ExpenseItem.new %>
      </div>
    </div>
  </div>

  <%# 明細編集モーダル %>
  <% @expense_report.expense_items.each do |item| %>
    <div class="modal fade" id="editItemModal-<%= item.id %>" tabindex="-1" 
         aria-labelledby="addItemModalLabel-<%= item.id %>" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header border-0 pb-0">
            <h5 class="modal-title fw-bold" id="addItemModalLabel-<%= item.id %>">明細を編集</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <%= render "expense_items/edit_form", expense_report: @expense_report, expense_item: item %>
        </div>
      </div>
    </div>
  <% end %>
</div>
