<%# locals: reports (required), title (optional), show_all_link (optional) %>
<div class="card p-3 p-lg-4" style="border-radius: 1rem">
  <div class="row px-3 py-2 mb-0 border-bottom">
    <div class="col">
      <h3 class="h6 fw-bold mb-0"><%= local_assigns.fetch(:title, "申請一覧") %></h3>
    </div>
  </div>

  <% if reports.empty? %>
    <div class="text-center py-5 text-secondary">
      <i class="bi bi-inbox fs-2 d-block mb-2"></i>
      <p class="mb-0 small">申請がありません</p>
    </div>
  <% else %>
    <%# テーブルヘッダー %>
    <div class="row px-3 py-1 mb-0 small text-secondary border-bottom d-none d-md-flex">
      <div class="col-md-5">タイトル</div>
      <div class="col-md-2 text-center">申請日</div>
      <div class="col-md-2 text-end">金額</div>
      <div class="col-md-2 text-center">ステータス</div>
      <div class="col-md-1"></div>
    </div>

    <%# 各行 %>
    <% reports.each do |report| %>
      <%= link_to expense_report_path(report), class: "row px-2 py-2 px-md-4 py-md-3 align-items-center text-decoration-none border-bottom list-table-row" do %>
        <div class="col-12 col-md-5 fw-semibold text-on-surface"><%= report.title %></div>
        <div class="col-4 col-md-2 text-center text-secondary small">
          <%= report.created_at.to_date.to_fs(:date_jp) %>
        </div>
        <div class="col-4 col-md-2 text-md-end fw-bold text-on-surface">
          ¥<%= number_with_delimiter((report.total_amount || 0).to_i) %>
        </div>
        <div class="col-4 col-md-2 text-center">
          <span class="status-badge badge-<%= report.status %>">
            <%= { "draft" => "下書き", "submitted" => "提出済み", "approved" => "承認済み" }[report.status] %>
          </span>
        </div>
        <div class="col-12 col-md-1 text-end d-none d-md-block">
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if local_assigns[:show_all_link] %>
    <div class="text-center mt-2">
      <%= link_to expense_reports_path, class: "text-decoration-none small", style: "color: var(--on-surface-variant);" do %>
        すべての申請履歴を表示<i class="bi bi-chevron-right"></i>
      <% end %>
    </div>
  <% end %>
</div>
