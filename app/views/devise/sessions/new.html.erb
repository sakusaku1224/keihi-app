<%# ログイン画面 %>
<main class="container">
  <div class="row justify-content-center">
    <div class="col-mb-12 text-center mb-4">
      <%= image_tag "KeiHi-logo-1.png", alt: "keihi", height: "45", class: "mb-2" %>
      <span class="small text-secondary d-block">立替経費申請アプリ</span>
    </div>
  
    <div class="col-11 col-mb-12">
      <%# ログインカード %>
      <div class="card login-card mx-auto">
        <div class="card-body p-4 p-md-5">
          <%# タイトル %>
          <div class="text-center mb-4">
            <h1 class="h4 mb-2">ログイン</h1>
            <p class="text-secondary small mb-0">
              アカウント情報を入力してください
            </p>
          </div>

          <%# フォーム %>
          <%= form_with(model: resource, as: resource_name, url: session_path(resource_name), local: true) do |f| %>
            <%# メール %>
            <div class="mb-4">
              <%= f.label :email, "メールアドレス", class: "form-label" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-with-icon", placeholder: "メールアドレスを入力" %>             
              </div>
            </div>

            <%# パスワード %>
            <div class="mb-2">
              <%= f.label :password, "パスワード", class: "form-label" %>
              <div class="input-group" data-controller="password">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <%= f.password_field :password, autocomplete: "current-password",class: "form-control", data: { password_target: "input" }, placeholder: "••••••••" %>
                <%# アイコンを押したときだけパスワードが見える %>
                <button type="button" class="btn border-start-0 border" data-action="click->password#toggle">
                  <i class="bi bi-eye" data-password-target="icon"></i>
                </button>
              </div>
            </div>
            <%# ログイン失敗エラー（invalid/not_found のalertのみ表示）%>
            <% login_failure_messages = [I18n.t("devise.failure.invalid"), I18n.t("devise.failure.not_found_in_database")] %>
            <% if login_failure_messages.include?(flash[:alert]) %>
              <div class="invalid-feedback d-block">ログインできません</div>
            <% end %>
            <%# ログインボタン %>
            <%= f.submit "ログイン", class: "btn btn-primary-keihi w-100 rounded-2 mb-2 mt-3 shadow-sm" %>   
          <% end %>

          <div class="divider">または</div>
          <%# ゲストログイン %>
          <div class="text-center">
            <%= button_to "ゲストログイン", guest_sign_in_path, method: :post, class: "btn btn-outline-custom w-100 rounded-2 mb-2" %>
            <p class="small text-secondary mb-0">テスト用</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 text-center mt-4">
      <%# フッターリンク %>
      <%= link_to "新規登録はこちら", new_user_registration_path, class: "text-primary-link" %>
    </div>
  </div>
</main>
