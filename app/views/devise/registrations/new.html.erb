<%# 新規登録画面 %>
<main class="container">
  <div class="row justify-content-center">
    <div class="col-12 text-center mb-4">
      <%# ロゴ %>
      <%# 後ほど画像挿入 %>
    </div>
  
    <div class="col-12">
      <%# 新規登録カード %>
      <div class="card login-card mx-auto">
        <div class="card-body p-4 p-md-5">
          <%# タイトル %>
          <div class="text-center mb-4">
            <h1 class="h4 mb-4">新規登録</h1>
            <p class="text-secondary small mb-0">
              必要な情報を入力してください
            </p>
          </div>

          <%# フォーム %>
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%# 名前 %>
            <div class="mb-3">
              <%= f.label :name, "名前", class: "form-label small text-secondary fw-semibold required" %>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-person"></i>
                </span>
                <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "form-control form-control-with-icon", placeholder: "ユーザー名を入力" %>             
              </div>
            </div>

            <%# 部署 %>
            <div class="mb-3">
              <%= f.label :department, "部署", class: "form-label small text-secondary fw-semibold required" %>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-building"></i>
                </span>
                <%= f.text_field :department, autofocus: true, autocomplete: "name", class: "form-control form-control-with-icon", placeholder: "所属部署を入力" %>             
              </div>
            </div>

            <%# メール %>
            <div class="mb-3">
              <%= f.label :email, "メールアドレス", class: "form-label small text-secondary fw-semibold required" %>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-envelope"></i>
                </span>
                <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-with-icon", placeholder: "メールアドレスを入力" %>             
              </div>
            </div>

            <%# パスワード %>
            <div class="mb-4">
              <%= f.label :password, "パスワード", class: "form-label small text-secondary fw-semibold mb-0 required"%>
              <% if @minimum_password_length %>
                <small class="text-muted">（<%= @minimum_password_length %>文字以上）</small>
              <% end %>
              <div class="input-group" data-controller="password">
                <span class="input-group-text">
                  <i class="bi bi-lock"></i>
                </span>
                <%= f.password_field :password, autocomplete: "new-password",class: "form-control", data: { password_target: "input" }, placeholder: "パスワードを入力" %>
                <%# アイコンを押したときだけパスワードが見える %>
                <button type="button" class="btn border-start-0 border" data-action="click->password#toggle">
                  <i class="bi bi-eye" data-password-target="icon"></i>
                </button>
              </div>
            </div>

            <%# 確認用 %>
            <div class="mb-4">
              <%= f.label :password_confirmation, "パスワード(確認)", class: "form-label small text-secondary fw-semibold mb-0 required"%>
              <div class="input-group" data-controller="password">
                <span class="input-group-text">
                  <i class="bi bi-lock"></i>
                </span>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", data: { password_target: "input" }, placeholder: "パスワードを入力(確認用)" %>
                <%# アイコンを押したときだけパスワードが見える %>
                <button type="button" class="btn border-start-0 border" data-action="click->password#toggle">
                  <i class="bi bi-eye" data-password-target="icon"></i>
                </button>
              </div>
            </div>          

            <%# 新規登録 %>
            <%= f.submit "新規登録", class: "btn btn-primary-custom w-100 rounded-2 mb-2 shadow-sm" %>   
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12 text-center mt-4">
      <%# フッターリンク %>
      <%= link_to "ログインはこちら", new_user_session_path, class: "text-primary-link" %>
    </div>
  </div>
</main>
