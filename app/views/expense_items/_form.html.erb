<%# モーダル フォーム部分 %>
<%= form_with model: [@expense_report, expense_item], html: { id: "new_item_form" } do |f| %>
  <%# body %>
  <div class="modal-body px-4 py-4">
    <div class="row g-4">
      <%# 左カラム（新規・編集 共通の入力項目） %>
      <%= render "expense_items/fields", f: f, expense_item: expense_item %>

      <%# 右カラム %>
      <div class="col-md-6 d-flex flex-column">
        <%= f.label :receipt_image, "領収書 (画像またはPDF)", class: "form-label"%>
        <%= f.file_field :receipt_image, class: "d-none", id: "receipt-file-input", accept: "image/png,image/jpeg,application/pdf"%>
        <div class="flex-grow-1 position-relative" style="min-height: 250px;">
          <div id="upload-zone" class="upload-zone h-100 d-flex flex-column align-items-center justify-content-center">
            <i class="bi bi-file-earmark-arrow-up fs-3 text-secondary"></i>
            <div class="fw-semibold small">領収書をアップロードして自動入力</div>
            <% if @unlinked_receipts.present? %>
              <div class="small text-secondary" style="font-size: 0.75rem">
                または
              </div>
            <% end %>
            <%# レシートBOXボタン %>
            <input type="hidden" id="selected_receipt_id" name="receipt_id" value="">
            <% if @unlinked_receipts.present? %>
            <div class="dropdown-center">
              <button onclick="event.stopPropagation()" type="button" data-bs-toggle="dropdown" class="btn btn-outline-keihi rounded-3 fw-bold py-2 dropdown-toggle">レシートBOXから選択</button>
              <ul class="dropdown-menu shadow-sm p-2" style="min-width: 280px; border-radius: 0.75rem;" onclick="event.stopPropagation()">
                <% @unlinked_receipts.each do |receipt| %>
                  <li>
                    <a class="dropdown-item rounded-2 py-2 px-3" href="#"
                       onclick="event.stopPropagation(); event.preventDefault();
                          fetch('/receipts/<%= receipt.id%>.json')
                              .then(r=>r.json())
                              .then(d=>{
                                fillFormFromOcr(d)
                                document.getElementById('selected_receipt_id').value = d.id;
                                document.getElementById('preview-img').src = d.image_url;
                                document.getElementById('upload-zone').classList.add('d-none');
                                document.getElementById('preview-card').classList.remove('d-none');
                              })">
                      <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold small"><%= receipt.payee || "支払先不明" %></span>
                        <span class="fw-bold small" style="color: var(--primary-color);">¥<%= number_with_delimiter(receipt.amount.to_i) %></span>
                      </div>
                      <div class="small text-secondary" style="font-size: 0.75rem;"><%= receipt.occurred_on&.to_fs(:date_jp) || "-" %></div>
                    </a>
                  </li>
                <% end %>
              </ul>
            </div>
            <% end %>
          </div>

          <%# 画像プレビューカード %>
          <div id="preview-card" class="d-none position-absolute bg-white border rounded-3 p-2 overflow-hidden" style="top: 0; left: 0; right: 0; bottom: 0;">
            <%# プレビュー画像（画像ファイルのとき） %>
            <img id="preview-img" class="img-fluid rounded w-100 h-100" style="object-fit: contain;" src="" alt="領収書">
            <%# PDF プレビュー（PDFのとき） %>
            <embed id="pdf-preview" class="d-none rounded w-100 h-100" type="application/pdf" src="">
            <%# 取り消しボタン %>
            <button id="clear-preview-btn" type="button" class="btn btn-sm btn-dark position-absolute top-0 end-0 m-2" style="width: 28px; height: 28px; padding: 0;">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </div>
        <button id="ocr-btn" type="button" class="btn btn-secondary w-100 mt-2 d-none">
          <i class="bi bi-magic"></i> OCR 読み取り
        </button>
      </div>
    </div>
  </div>

  <%# フッター %>
  <div class="modal-footer px-4 py-3 bg-light border-top">
    <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-semibold" data-bs-dismiss="modal">キャンセル</button>
    <div class="ms-auto">
      <%= f.submit "保存する", class: "btn btn-primary-keihi rounded-2 px-5 py-2 fw-semibold" %>
    </div>
  </div>
<% end %>
