<%# 編集モーダル　 %>
<%= form_with model: [@expense_report, expense_item] do |f| %>
  <%# body %>
  <div class="modal-body px-4 py-4">
    <div class="row g-4">
      <%# 左カラム %>
      <div class="col-md-6">
        <div class="row g-3">
          <div class="col-12">
            <%= f.label :item_name, "内容", class: "form-label" %>
            <%= f.text_field :item_name, class: "form-control", placeholder: "例：タクシー代、文房具購入" %>
          </div>
          <div class="col-6">
            <%= f.label :category, "種別", class: "form-label" %>
            <%= f.select :category, ExpenseItem::CATEGORIES, { prompt: "選択してください" }, { class: "form-select" } %>
          </div>
          <div class="col-6">
            <%= f.label :occurred_on, "発生日", class: "form-label" %>
            <div class="input-group">
              <i class="bi bi-calendar-event input-group-text bg-white"></i>
              <%= f.date_field :occurred_on, class: "form-control" %>
            </div>
          </div>
          <div class="col-6">
            <%= f.label :payee, "支払先", class: "form-label" %>
            <%= f.text_field :payee, class: "form-control", placeholder: "会社名、店舗名" %>
          </div>
          <div class="col-6">
            <%= f.label :amount, "金額 (税込)", class: "form-label" %>
            <div class="input-group">
              <span class="input-group-text bg-white">¥</span>
              <%= f.text_field :amount, class: "form-control text-end", placeholder: "0", value: expense_item.amount.to_i %>
            </div>
          </div>
          <div class="col-12">
            <%= f.label :invoice_registration_number, "適格請求書発行事業者登録番号", class: "form-label" %>
            <%= f.text_field :invoice_registration_number, class: "form-control", placeholder: "T1234567890123" %>
          </div>
          <div class="col-12">
            <%= f.label :tax_rate, "税率", class: "form-label" %>
            <div class="d-flex flex-column gap-2">
            <% [["標準税率 (10%)", 10], ["軽減税率 (8%)", 8], ["非課税/免税", 0]].each do |label_text, value| %>
              <label class="tax-rate-option">
                <div class="form-check m-0">
                  <%= f.radio_button :tax_rate, value, checked: expense_item.tax_rate == value, class: "form-check-input" %>
                  <p class="form-check-label small"><%= label_text %></p>
                </div>
              </label>
            <% end %>  
            </div>
          </div>
        </div>
      </div>

      <%# 右カラム %>
      <div class="col-md-6 d-flex flex-column">
        <%= f.label :receipt_image, "領収書", class: "form-label"%>
        <div class="flex-grow-1 border rounded-3 p-2 d-flex align-items-center justify-content-center" 
             style="min-height: 200px;">
          <% if expense_item.receipt_image.attached? %>
            <% if expense_item.receipt_image.content_type == "application/pdf" %>
              <embed src="<%= rails_blob_path(expense_item.receipt_image) %>"
                     type="application/pdf"
                     class="rounded w-100 h-100"
                     style="min-height: 300px;">
            <% else %>
              <%= image_tag expense_item.receipt_image, class: "img-fluid rounded w-100 h-100", style: "object-fit: contain;" %>
            <% end %>
          <% else %>
            <div class="text-secondary text-center">
              <i class="bi bi-image fs-3"></i>
              <div class="small mt-2">領収書なし</div>
            </div>            
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# フッター %>
  <div class="modal-footer px-4 py-3 bg-light border-top">
    <button type="button" class="btn btn-outline-secondary px-4 fw-semibold" data-bs-dismiss="modal">キャンセル</button>
    <div class="ms-auto">
      <%= f.submit "保存する", class: "btn btn-primary-keihi px-5 fw-bold" %>
    </div>
  </div>
<% end %>
