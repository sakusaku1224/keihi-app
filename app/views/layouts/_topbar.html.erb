<%# トップバー %>
<header class="top-bar">
  <div class="d-flex align-items-center gap-2">
    <%# ハンバーガー（モバイルのみ） %>
    <button class="btn btn-link p-0 text-dark d-md-none" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
      <i class="bi bi-list fs-4"></i>
    </button>
    <h1 class="fs-5 m-0"><%= yield :page_title %></h1>
  </div>
  <div class="d-flex align-items-center gap-4">
    <%# 新規作成ボタン（デスクトップのみ） %>
    <%= link_to new_expense_report_path, class: "btn btn-primary-keihi py-2 d-none d-lg-inline-flex" do %>
      <i class="bi bi-plus-circle"></i>新規作成
    <% end %>
    <%# アイコン %>
    <div class="avatar">
      <%= current_user.name[0] %>
    </div>
  </div>
</header>

<%# モバイル用 offcanvas メニュー %>
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu" style="max-width: 280px;">
  <div class="offcanvas-header">
    <%= image_tag "KeiHi-logo-1.png", alt: "keihi", height: "32" %>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body p-0">
    <nav class="d-flex flex-column p-3" id="mobile-nav">
      <%= link_to root_path, class: "nav-link" do %>
        <i class="bi bi-columns-gap fs-5"></i>
        <span class="fw-bold">ダッシュボード</span>
      <% end %>
      <%= link_to expense_reports_path, class: "nav-link" do %>
        <i class="bi bi-card-list fs-5"></i>
        <span class="fw-bold">申請一覧</span>
      <% end %>
      <%= link_to new_expense_report_path, class: "nav-link" do %>
        <i class="bi bi-plus-circle fs-5"></i>
        <span class="fw-bold">新規作成</span>
      <% end %>
      <%= link_to receipts_path, class: "nav-link" do %>
        <i class="bi bi-inbox fs-5"></i>
        <span class="fw-bold">未申請BOX</span>
      <% end %>
      <%= link_to expense_reports_path(status: "draft"), class: "nav-link" do %>
        <i class="bi bi-pencil-square fs-5"></i>
        <span class="fw-bold">下書き</span>
      <% end %>
      <%= link_to expense_reports_path(status: "submitted"), class: "nav-link" do %>
        <i class="bi bi-send fs-5"></i>
        <span class="fw-bold">提出済み</span>
      <% end %>
      <%= link_to expense_reports_path(status: "approved"), class: "nav-link" do %>
        <i class="bi bi-patch-check fs-5"></i>
        <span class="fw-bold">承認済み</span>
      <% end %>
    </nav>
    <div class="mt-auto p-3 border-top">
      <%= link_to destroy_user_session_path, data: {turbo_method: :delete}, class: "nav-link" do %>
        <i class="bi bi-box-arrow-right"></i>
        <span>ログアウト</span>
      <% end %>
    </div>
  </div>
</div>
