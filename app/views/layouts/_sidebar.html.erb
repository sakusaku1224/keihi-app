<%# サイドバー %>
<aside class="sidebar d-none d-md-flex" id="sidebar">
  <div class="d-flex align-items-center mb-4 sidebar-header">
    <%# ロゴ %>
    <div class="logo-text">
      <%= image_tag "KeiHi-logo-1.png", alt: "keihi", height: "32" %>
    </div>
    <%# トグル %>
    <div data-controller="sidebar">
      <button class="btn btn-link p-0 text-secondary" data-action="click->sidebar#toggle">
        <i class="bi bi-list fs-4"></i>
      </button>
    </div>
  </div>
  <%# ナビゲーション %>
  <nav class="flex-grow-1">
    <%= link_to root_path, class: "nav-link" do %>
      <i class="bi bi-columns-gap fs-5"></i>
      <span class="font-body-md nav-text fw-bold">ダッシュボード</span>
    <% end %>
    <%= link_to expense_reports_path, class: "nav-link" do %>
      <i class="bi bi-card-list fs-5"></i>
      <span class="font-body-md nav-text fw-bold">申請一覧</span>
    <% end %>
    <%= link_to new_expense_report_path, class: "nav-link" do %>
      <i class="bi bi-plus-circle fs-5"></i>
      <span class="font-body-md nav-text fw-bold">新規作成</span>
    <% end %>
    <%= link_to receipts_path, class: "nav-link" do %>
      <i class="bi bi-inbox fs-5"></i>
      <span class="font-body-md nav-text fw-bold">レシートBOX</span>
    <% end %>
    <%= link_to expense_reports_path(status: "draft"), class: "nav-link" do %>
      <i class="bi bi-pencil-square fs-5"></i>
      <span class="font-body-md nav-text fw-bold">下書き</span>
    <% end %>
    <%= link_to expense_reports_path(status: "submitted"), class: "nav-link" do %>
      <i class="bi bi-send fs-5"></i>
      <span class="font-body-md nav-text fw-bold">提出済み</span>
    <% end %>
    <%= link_to expense_reports_path(status: "approved"), class: "nav-link" do %>
      <i class="bi bi-patch-check fs-5"></i>
      <span class="font-body-md nav-text fw-bold">承認済み</span>
    <% end %>
  </nav>

  <%# 下部ログアウト %>
  <div class="pt-3 border-top">
    <%= link_to destroy_user_session_path, data: {turbo_method: :delete}, class: "nav-link" do %>
      <i class="bi bi-box-arrow-right"></i>
      <span class="font-body-md nav-text">ログアウト</span>
    <% end %>
  </div>
</aside>