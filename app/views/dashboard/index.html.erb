<% content_for :page_title, "ダッシュボード" %>
<div class="container-field px-4 px-lg-5">
  <%# グリーティング %>
  <div class="mb-4">
    <p class="text-secondary small mb-0"><%= Date.today.strftime("%Y年%-m月%-d日") %> — <%= current_user.name %>さん、こんにちは</p>
  </div>

  <%# サマリーカード %>
  <div class="row g-2 mb-3">
    <%# 下書き件数 %>
    <div class="col-12 col-md-4">
      <%= link_to expense_reports_path(status: "draft"), class: "text-decoration-none" do %>
        <div class="summary-card accent-yellow d-flex align-items-center gap-4">
          <div class="icon-box" style="background-color: #fef3c7; color: #d97706;">
            <i class="bi bi-pencil-square"></i>
          </div>
          <div class="d-flex align-items-baseline gap-2">
            <span class="small fw-bold card-label">下書き</span>
            <span class="fs-4 text-dark fw-bold"><%= @draft_count || 0 %></span>
            <span class="text-secondary small">件</span>
          </div>
        </div>
      <% end %>
    </div>

    <%# 提出済み件数 %>
    <div class="col-12 col-md-4">
      <%= link_to expense_reports_path(status: "submitted"), class: "text-decoration-none" do %>
        <div class="summary-card accent-blue d-flex align-items-center gap-4">
          <div class="icon-box" style="background-color: #dce4f0; color: #3a4f6e;">
            <i class="bi bi-send"></i>
          </div>
          <div class="d-flex align-items-baseline gap-2">
            <span class="small fw-bold card-label">提出済み</span>
            <span class="fs-4 text-dark fw-bold"><%= @submitted_count || 0 %></span>
            <span class="text-secondary small">件</span>
          </div>
        </div>
      <% end %>
    </div>

    <%# 承認済み件数 %>
    <div class="col-12 col-md-4">
      <%= link_to expense_reports_path(status: "approved"), class: "text-decoration-none" do %>
        <div class="summary-card accent-green d-flex align-items-center gap-4">
          <div class="icon-box" style="background-color: #c8ddd4; color: #1a4d3a;">
            <i class="bi bi-patch-check"></i>
          </div>
          <div class="d-flex align-items-baseline gap-2">
            <span class="small fw-bold card-label">承認済み</span>
            <span class="fs-4 text-dark fw-bold"><%= @approved_count || 0 %></span>
            <span class="text-secondary small">件</span>
          </div>
        </div>
      <% end %>
    </div>

    <%# 今月の合計 %>
    <div class="col-12 col-md-12 mt-3">
      <div class="summary-card accent-primary shadow-sm d-flex align-items-center gap-4" >
        <div class="icon-box" style="background: var(--primary-light); color: var(--primary-color);">
          <i class="bi bi-cash-stack"></i>
        </div>
        <div class="d-flex align-items-baseline gap-2">
          <span class="small fw-bold card-label">今月の合計</span>
          <span class="fs-4 fw-bold" style="color: var(--primary-color);">¥<%= number_with_delimiter((@monthly_count || 0).to_i) %></span>
        </div>
      </div>
    </div>
  </div>

  <%# 最近の申請一覧 %>
  <div class="row">
    <div class="col-12">
      <%= render "expense_reports/list",
                 reports: @recent_reports,
                 title: "最近の申請一覧",
                 show_all_link: true %>
    </div>
  </div>
</div>
