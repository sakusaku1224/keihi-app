<% content_for :page_title, "ダッシュボード" %>
<div class="container-field px-4 px-lg-5">
  <%# グリーティング %>
  <div class="mb-2">
    <p class="text-secondary small mb-0"><%= Date.today.strftime("%Y年%-m月%-d日") %> — <%= current_user.name %>さん、こんにちは</p>
  </div>
  <%# バナー %>
  <% if @reminder_level == :critical %>
    <div class="alert alert-danger align-items-center small fw-bold py-2 d-flex gap-2 mb-1" role="alert">
      <i class="bi bi-alarm"></i>
      <span>本日は締日です。申請をお忘れなく！</span>
    </div>
  <% elsif @reminder_level == :urgent %>
    <div class="alert alert-warning align-items-center small fw-bold py-2 d-flex gap-2 mb-1" role="alert">
      <i class="bi bi-alarm"></i>
      <span>締日まであと<%= @deadline_days %>日です。早めに申請をしましょう！</span>
    </div>
  <% elsif @reminder_level == :warning %>
    <div class="alert alert-secondary align-items-center small fw-bold py-2 d-flex gap-2 mb-1" role="alert">
      <i class="bi bi-alarm"></i>
      <span>締日まであと<%= @deadline_days %>日です。早めに申請をしましょう！</span>
    </div>
  <% end %>

  <%# 未回収金額 %>
  <div class="summary-card mb-3">
    <div class="row align-items-center">
      <div class="col-12 col-md-7">
        <div class="d-flex align-items-center gap-2 mb-1 fw-bold card-label">
          <i class="bi bi-patch-exclamation"></i>
          <span class="small">未申請の合計金額（全件）</span>
        </div>
        <div class="fw-bold fs-1" style="color: var(--primary-color);">¥<%= number_with_delimiter(@uncollected_amount || 0) %></div>
        <div class="d-md-flex align-items-center gap-3 pt-2 border-top small text-secondary">
          <div class="d-flex gap-1 align-items-center mb-1 mb-md-0">
            <i class="bi bi-clock"></i>
            締日まで <span class="fw-bold text-black">あと<%= @deadline_days %>日</span>
          </div>
          <div class="d-flex gap-3">
            <span>レシートBOX <span class="fw-bold text-black"><%= @unlinked_count || 0 %>件</span></span>
            <span>下書き <span class="fw-bold text-black"><%= @draft_count || 0 %>件</span></span>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-5 mt-3 mt-md-0">
        <%# モバイル %>
        <div class="d-md-none d-flex gap-2">
          <%= form_with url: receipts_path, scope: :receipt, method: :post, id: "dashboard-receipt-form", class: "d-none" do |f| %>
            <%= f.file_field :receipt_image, id: "dashboard-receipt-form-file" %>
          <% end %>
          <%= link_to receipts_path, class: "btn btn-outline-keihi rounded-2 py-2 flex-fill fw-bold" do %>
            <i class="bi bi-inbox"></i> レシートBOX
          <% end %>
          <%= link_to expense_reports_path(status: "draft"), class: "btn btn-outline-draft rounded-2 py-2 flex-fill fw-bold" do %>
            <i class="bi bi-pencil-square"></i> 下書き一覧
          <% end %>
        </div>
        <%# デスクトップ %>
        <div class="d-none d-md-grid gap-2">
          <%= link_to receipts_path, class: "btn btn-outline-keihi rounded-2 px-5 py-2 fw-bold" do %>
            レシートBOXを開く →
          <% end %>
          <%= link_to expense_reports_path(status: "draft"), class: "btn btn-outline-draft rounded-2 px-5 py-2 fw-bold" do %>
            下書き一覧を開く →
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# 分析エリア %>
  <div class="row g-2 g-md-3 mb-3">
    <%# 月次推移グラフ %>
    <div class="col-12 col-md-7">
      <div class="summary-card h-100 d-flex flex-column justify-content-center">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <div class="small fw-bold card-label">申請済み月次推移</div>
        </div>
        <div id="chart-data"
          data-labels="<%= @monthly_labels.to_json %>"
          data-values="<%= @monthly_values.to_json %>"
          data-draft="<%= @draft_count %>"
          data-submitted="<%= @submitted_count %>"
          data-approved="<%= @approved_count %>"
          style="display:none"></div>
        <div style="position: relative; height: 150px;">
          <canvas id="monthlyChart"></canvas>
        </div>
      </div>
    </div>

    <%# ステータス件数 %>
    <div class="col-12 col-md-5 d-flex flex-column gap-2">
      <%= link_to expense_reports_path(status: "draft"), class: "text-decoration-none" do %>
        <div class="summary-card d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box" style="background-color: #fef3c7; color: #d97706;">
              <i class="bi bi-pencil-square"></i>
            </div>
            <span class="small card-label">下書き</span>
          </div>
          <div class="d-flex align-items-baseline gap-1">
            <span class="fs-4 text-dark fw-bold"><%= @draft_count || 0 %></span>
            <span class="text-secondary small">件</span>
          </div>
        </div>
      <% end %>

      <%= link_to expense_reports_path(status: "submitted"), class: "text-decoration-none" do %>
        <div class="summary-card d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box" style="background-color: #dce4f0; color: #3a4f6e;">
              <i class="bi bi-send"></i>
            </div>
            <span class="small card-label">提出済み</span>
          </div>
          <div class="d-flex align-items-baseline gap-1">
            <span class="fs-4 text-dark fw-bold"><%= @submitted_count || 0 %></span>
            <span class="text-secondary small">件</span>
          </div>
        </div>
      <% end %>

      <%= link_to expense_reports_path(status: "approved"), class: "text-decoration-none" do %>
        <div class="summary-card d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box" style="background-color: #c8ddd4; color: #1a4d3a;">
              <i class="bi bi-patch-check"></i>
            </div>
            <span class="small card-label">承認済み</span>
          </div>
          <div class="d-flex align-items-baseline gap-1">
            <span class="fs-4 text-dark fw-bold"><%= @approved_count || 0 %></span>
            <span class="text-secondary small">件</span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# 最近の申請一覧 %>
  <%= render "expense_reports/list",
             reports: @recent_reports,
             title: "最近の申請一覧",
             show_all_link: true %>
</div>

<%# モバイル用stickyバー %>
<div class="d-md-none receipt-sticky-btn p-3">
  <div class="d-flex gap-2">
    <label class="btn btn-outline-keihi rounded-3 fw-bold py-2 flex-fill mb-0" style="cursor: pointer;">
      <i class="bi bi-camera"></i> レシートを撮る
      <input type="file" accept="image/*" capture="environment" class="d-none"
             onchange="document.getElementById('dashboard-receipt-form-file').files = this.files; document.getElementById('dashboard-receipt-form').requestSubmit();">
    </label>
    <%= link_to new_expense_report_path, class: "btn btn-primary-keihi rounded-3 fw-bold py-2 flex-fill" do %>
      <i class="bi bi-plus-circle"></i> 新規作成
    <% end %>
  </div>
</div>
