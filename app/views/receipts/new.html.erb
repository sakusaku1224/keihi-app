<% content_for :page_title, "レシートを追加" %>

<%# アップロードエリア %>
<%# js未実装 %>
<%= form_with model: @receipt do |f| %>
  <div class="col-md-12 d-flex flex-column px-5">
    <%= link_to receipts_path, class: "text-decoration-none d-flex align-items-center mb-3" do %>
      <i class="bi bi-arrow-left text-secondary"></i>
      <span class="text-secondary ms-1 fw-bold">未申請BOXに戻る</span>
    <% end %>
    <%= f.file_field :receipt_image, class: "", id: "receipt-file-input", accept: "image/*", capture: "environment"%>
    <div class="flex-grow-1 position-relative mb-3">
      <div class="upload-zone h-100 d-flex flex-column align-items-center justify-content-center">
        <i class="bi bi-file-earmark-image fs-1 text-secondary"></i>
        <div class="fw-semibold small">タップして撮影/画像をアップロード</div>
        <div class="small text-secondary" style="font-size: 0.75rem">
          金額・日付は自動で読み取られます
        </div>
      </div>
    </div>
    <%= f.submit "保存", class: "btn btn-secondary w-100 mt-2" %>
  </div>
<% end %>
