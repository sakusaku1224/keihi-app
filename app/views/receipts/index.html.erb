<% content_for :page_title, "レシートBOX" %>

<div class="container-field px-3 px-lg-5">
  <div class="mb-1">
    <p class="text-secondary small mb-0">領収書を一時保存するBOXです</p>
  </div>
  <%# サマリー %>
  <div class="row g-3 mb-3">
    <%# 未回収金額 %>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="receipt-summary-card h-100">
        <div class="receipt-summary-label mb-1">未回収金額（合計）</div>
        <div class="receipt-summary-amount">
          ¥<%= number_with_delimiter((@receipts.sum(:amount) || 0).to_i) %>
        </div>
      </div>
    </div>
    <%# レシート件数 %>
    <div class="col-6 col-md-3 col-lg-4">
      <div class="summary-card h-100">
        <div class="receipt-summary-sub mb-1">レシート件数</div>
        <div class="receipt-summary-value"><%= @receipts.count || 0 %><span class="receipt-summary-sub ms-1">件</span></div>
      </div>
    </div>
    <%# 最終追加日 %>
    <div class="col-6 col-md-3 col-lg-4">
      <div class="summary-card h-100">
        <div class="receipt-summary-sub mb-1">最終追加日</div>
        <div class="receipt-summary-value"><%= @receipts.maximum(:created_at)&.strftime("%Y/%-m/%-d") || "-" %></div>
      </div>
    </div>
  </div>
  <%# 一覧 %>
  <div class="row px-3 py-2 mb-0">
    <div class="col">
      <h3 class="h6 fw-bold mb-0">一覧</h3>
    </div>
  </div>

  <% if @receipts.empty? %>
    <div class="text-center py-3 text-secondary upload-zone card justify-content-center">
      <i class="bi bi-inbox fs-2 d-block mb-2"></i>
      <p class="mb-0">まずはレシートを撮影・保存するだけでOK。金額入力や申請はあとでまとめてできます。</p>
    </div>
  <% else %>
    <div class="card" style="border-radius: 0.875rem; overflow: hidden;">
      <%# === デスクトップ：テーブル表示 === %>
      <table class="table table-hover align-middle m-0 d-none d-md-table">
        <thead>
          <tr>
            <th style="width: 70px; padding: 0.75rem 1.25rem;"></th>
            <th class="fw-medium text-secondary">支払先</th>
            <th class="fw-medium text-secondary">カテゴリ</th>
            <th class="fw-medium text-secondary">日付</th>
            <th class="fw-medium text-secondary pe-4">金額</th>
            <th style="width: 50px;"></th>
          </tr>
        </thead>
        <tbody>
          <% @receipts.each do |receipt| %>
            <tr class="receipt-row">
              <%# アイコンクリックでプレビュー %>
              <td class="ps-4">
                <% if receipt.receipt_image.attached? %>
                  <div class="receipt-icon" style="cursor: pointer;"
                      onclick="document.getElementById('modal-preview-img').src = '<%= url_for(receipt.receipt_image)%>' ;new 
                      bootstrap.Modal(document.getElementById('imagePreviewModal')).show();">
                    <i class="bi bi-receipt"></i>
                  </div>
                <% else %>
                  <div class="receipt-icon">
                    <i class="bi bi-receipt"></i>
                  </div>
                <% end %>
              </td>
              <td class="fw-bold"><%= receipt.payee %></td>
              <td class="small text-secondary"><%= category_dot(receipt.category) %><%= receipt.category %></td>
              <td class="small text-secondary"><%= receipt.created_at.to_date.to_fs(:date_jp) %></td>
              <td class="fw-bold pe-4">¥<%= number_with_delimiter(receipt.amount.to_i) %></td>
              <td>
                <%= link_to receipt_path(receipt), data: { turbo_method: :delete, turbo_confirm: "この領収書を削除しますか？" }, class: "btn btn-sm btn-link text-secondary p-0" do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
          <%# 合計行 %>
          <tr class="receipt-total-row">
            <td></td>
            <td class="small text-secondary"><span class="fw-bold m-2">合計</span><%= (@receipts.count || 0).to_i %>件</td>
            <td></td>
            <td></td>
            <td class="fw-bold pe-4" style="color: var(--primary-color);">¥<%= number_with_delimiter((@receipts.sum(:amount) || 0).to_i) %></td>
            <td></td>
          </tr>
        </tbody>
      </table>

      <%# === モバイル：カード表示 === %>
      <div class="d-md-none">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
          <span class="small text-secondary fw-bold">支払先 / 日付</span>
          <span class="small text-secondary fw-bold">金額</span>
        </div>
        <% @receipts.each do |receipt| %>
          <div class="receipt-row d-flex align-items-center gap-3 p-3">
            <% if receipt.receipt_image.attached? %>
              <div class="receipt-icon" style="cursor: pointer;"
                  onclick="document.getElementById('modal-preview-img').src = '<%= url_for(receipt.receipt_image)%>' ;new 
                  bootstrap.Modal(document.getElementById('imagePreviewModal')).show();">
                <i class="bi bi-receipt"></i>
              </div>
            <% else %>
              <div class="receipt-icon">
                <i class="bi bi-receipt"></i>
              </div>
            <% end %>
            <div class="flex-fill" style="min-width: 0;">
              <div class="fw-bold text-truncate"><%= receipt.payee %></div>
              <div class="d-flex align-items-center gap-2 mt-1">
                <span class="small text-secondary"><%= receipt.category %></span>
                <span class="small text-secondary">·</span>
                <span class="small text-secondary"><%= receipt.created_at.to_date.to_fs(:date_jp) %></span>
              </div>
            </div>
            <div class="fw-bold text-nowrap">¥<%= number_with_delimiter(receipt.amount.to_i) %></div>
            <%= link_to receipt_path(receipt), data: { turbo_method: :delete, turbo_confirm: "この領収書を削除しますか？" }, class: "btn btn-sm btn-link text-secondary p-0" do %>
              <i class="bi bi-trash"></i>
            <% end %>
          </div>
        <% end %>
        <%# 合計行 %>
        <div class="receipt-total-row d-flex justify-content-between align-items-center p-3">
          <span class="small fw-bold text-secondary">
            合計 <span class="fw-normal"><%= (@receipts.count || 0).to_i %>件</span>
          </span>
          <span class="fw-bold" style="color: var(--primary-color);">
            ¥<%= number_with_delimiter((@receipts.sum(:amount) || 0).to_i) %>
          </span>
        </div>
      </div>
    </div>
  <% end %>
  <%# 追加ボタン（デスクトップ） %>
  <div class="d-none d-sm-block mt-3">
    <%= link_to new_receipt_path, class: "btn btn-primary-keihi w-100 rounded-3 fw-bold" do %>
      ＋ レシートを追加
    <% end %>
  </div>
</div>

<%# モバイル用stickyボタン %>
<div class="receipt-sticky-btn d-sm-none p-3">
  <%= link_to new_receipt_path, class: "btn btn-primary-keihi w-100 rounded-3 fw-bold py-3" do %>
    ＋ レシートを追加
  <% end %>
</div>
<%# 画像プレビューモーダル %>
<div class="modal fade" id="imagePreviewModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content bg-transparent border-0">
      <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
              data-bs-dismiss="modal"></button>
        <img id="modal-preview-img" class="img-fluid rounded" src="" alt="領収書">
    </div>
  </div>
</div>
